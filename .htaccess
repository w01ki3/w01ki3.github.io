# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# For Brotli (if the module is installed)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json
</IfModule>

# sw.js ASLA önbelleğe ALINMASIN (sürüm numarası kaynağı)
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# HTML dosyaları önbelleğe alınmasın
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
</FilesMatch>

# Resim & SVG — uzun önbellek (sürüm yönetimi yok)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

# Diğer CSS/JS — 1 yıl önbellek (QUERY STRING ile sürüm yönetimi var)
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>